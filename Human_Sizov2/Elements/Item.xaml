<UserControl x:Class="Human_Sizov2.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Human_Sizov2.Elements"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300"
             MouseDown="Speek">
    <Grid>
        <Border
            Margin="20"
            CornerRadius="20"
            Background="#FFAEAEAE"
            Width="220">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="220"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Image
                    x:Name="Img"
                    Margin="20"/>
                <Label
                    x:Name="lName"
                    Content=""
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="10,10,0,0"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Width="205"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    />
                <Label
                    x:Name="lRace"
                    Content=""
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="10,50,0,0"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Width="205"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    />
                <Label
                    x:Name="lText"
                    Content=""
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="10,90,0,0"
                    VerticalAlignment="Top"
                    Grid.Row="1"
                    Width="205"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="16"
                    />
            </Grid>

            <Border.Effect>
                <DropShadowEffect BlurRadius="3" Color="#7F000000"/>
            </Border.Effect>
         </Border>
    </Grid>
</UserControl>
